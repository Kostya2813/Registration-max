<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Max — вход</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;font-family:Arial,Helvetica,sans-serif;background:#17181c;color:#fff;overflow:hidden}
body{min-height:100dvh}
.screen{min-height:100dvh;position:relative;padding:0 20px;background:#17181c}
.top{
  height:142px;margin:0 -20px;padding-top:45px;text-align:center;
  background:#17181c
}
.logo{
  width:72px;height:72px;margin:0 auto;border-radius:22px;
  overflow:hidden;background:#fff
}
.logo img{
  width:100%;height:100%;display:block;object-fit:cover
}
.content{
  max-width:420px;margin:0 auto;padding-top:30px
}
h1{
  margin:0;text-align:center;font-size:27px;line-height:1.15;
  font-weight:700;letter-spacing:-.5px
}
.subtitle{
  margin:10px auto 27px;text-align:center;color:#a6a7ac;
  font-size:15px;line-height:1.4
}
.form{
  display:flex;flex-direction:column;gap:12px
}
.label{
  color:#a6a7ac;font-size:13px;margin:0 3px -5px
}
.input{
  width:100%;height:52px;border:1px solid #35373d;border-radius:14px;
  background:#24262b;color:#fff;padding:0 16px;font-size:16px;
  outline:none
}
.input::placeholder{color:#777a82}
.input:focus{
  border-color:#62656e;
  box-shadow:0 0 0 3px rgba(255,255,255,.04)
}
button{
  width:100%;height:52px;border:0;border-radius:14px;
  background:#303238;color:#777b84;font-size:16px;font-weight:700;
  margin-top:3px;transition:.15s
}
button.enabled{
  background:#1687ff;color:#fff
}
button:active{transform:scale(.99)}
.help{
  position:absolute;right:18px;bottom:18px;
  width:38px;height:38px;border-radius:50%;
  border:1px solid #44464d;background:#24262b;color:#d5d6da;
  font-size:20px;display:grid;place-items:center
}
.progress{
  display:none;margin-top:16px;text-align:center
}
.progressText{
  color:#b8bac0;font-size:13px;margin-bottom:9px
}
.bar{
  width:100%;height:5px;background:#303238;border-radius:99px;overflow:hidden
}
.fill{
  height:100%;width:0;background:#1687ff;border-radius:99px
}
.pct{
  margin-top:7px;color:#777b84;font-size:12px
}
.modal{
  display:none;position:fixed;inset:0;background:rgba(0,0,0,.62);
  align-items:center;justify-content:center;padding:20px;z-index:10
}
.modalBox{
  width:min(330px,100%);background:#24262b;border:1px solid #3a3c43;
  border-radius:18px;padding:23px;text-align:center
}
.modalBox p{
  margin:0 0 18px;font-size:16px;line-height:1.4
}
.modalBox button{
  background:#1687ff;color:#fff;margin:0
}
#matrix{
  display:none;position:fixed;inset:0;background:#000;z-index:20
}
#matrix canvas{
  position:absolute;inset:0;width:100%;height:100%
}
#final{
  position:absolute;inset:0;display:flex;align-items:center;
  justify-content:center;text-align:center;padding:25px;
  color:#00ff66;font-family:monospace;font-size:clamp(23px,7vw,42px);
  font-weight:800;text-shadow:0 0 9px #00ff66,0 0 25px #00ff66;
  opacity:0
}
#final.hidden{display:none}
#final.fadeIn{
  display:flex;
  animation:fadeIn 3s forwards
}
@keyframes fadeIn{
  from{opacity:0}
  to{opacity:1}
}
</style>
</head>
<body>

<div class="screen" id="loginScreen">
  <div class="top">
    <div class="logo" aria-label="MAX">
      <img
        src="data:image/png;base64,REPLACE_WITH_EMBEDDED_MAX_LOGO"
        alt="MAX"
      >
    </div>
  </div>

  <div class="content">
    <h1>Вход в MAX</h1>
    <div class="subtitle">Введите номер телефона, чтобы продолжить</div>

    <form class="form" id="phoneForm">
      <div class="label">Номер телефона</div>
      <input
        class="input"
        id="phone"
        inputmode="numeric"
        autocomplete="off"
        placeholder="+7"
      >
      <button id="phoneButton" type="submit" disabled>Продолжить</button>
    </form>

    <form class="form" id="passwordForm" style="display:none">
      <div class="label">Пароль</div>
      <input
        class="input"
        id="password"
        type="password"
        autocomplete="off"
        placeholder="Введите пароль"
      >
      <button id="passwordButton" type="submit" disabled>Войти</button>
    </form>

    <div class="progress" id="progress">
      <div class="progressText">Проверка данных...</div>
      <div class="bar">
        <div class="fill" id="fill"></div>
      </div>
      <div class="pct" id="pct">0%</div>
    </div>
  </div>

  <button class="help" id="help" type="button">?</button>
</div>

<div class="modal" id="modal">
  <div class="modalBox">
    <p>Заполните номер телефона и пароль</p>
    <button id="closeModal" type="button">Понятно</button>
  </div>
</div>

<section id="matrix">
  <canvas id="canvas"></canvas>
  <div id="final" class="hidden">ВАШИ ДАННЫЕ УКРАДЕНЫ</div>
</section>

<script>
document.addEventListener('DOMContentLoaded',()=>{
const phoneForm=document.getElementById('phoneForm');
const passwordForm=document.getElementById('passwordForm');
const phone=document.getElementById('phone');
const password=document.getElementById('password');
const phoneButton=document.getElementById('phoneButton');
const passwordButton=document.getElementById('passwordButton');
const progress=document.getElementById('progress');
const fill=document.getElementById('fill');
const pct=document.getElementById('pct');
const loginScreen=document.getElementById('loginScreen');
const matrix=document.getElementById('matrix');
const help=document.getElementById('help');
const modal=document.getElementById('modal');
const closeModal=document.getElementById('closeModal');

let phoneDigits='';

phone.addEventListener('input',()=>{
  let digits=phone.value.replace(/\D/g,'');
  if(digits.startsWith('7')) digits=digits.slice(1);
  digits=digits.slice(0,10);
  phoneDigits=digits;

  let formatted='+7';
  if(digits.length>0) formatted+=' '+digits.slice(0,3);
  if(digits.length>3) formatted+=' '+digits.slice(3,6);
  if(digits.length>6) formatted+='-'+digits.slice(6,8);
  if(digits.length>8) formatted+='-'+digits.slice(8,10);

  phone.value=formatted;
  phoneButton.disabled=digits.length!==10;
  phoneButton.classList.toggle('enabled',digits.length===10);
});

phoneForm.addEventListener('submit',e=>{
  e.preventDefault();
  if(phoneDigits.length!==10)return;

  phoneForm.style.display='none';
  passwordForm.style.display='flex';
  password.focus();
});

password.addEventListener('input',()=>{
  const ok=password.value.length>=8;
  passwordButton.disabled=!ok;
  passwordButton.classList.toggle('enabled',ok);
});

passwordForm.addEventListener('submit',e=>{
  e.preventDefault();
  if(password.value.length<8)return;

  phone.value='';
  password.value='';
  phoneDigits='';

  passwordForm.style.display='none';
  progress.style.display='block';

  let n=0;
  const timer=setInterval(()=>{
    n=Math.min(100,n+2);
    fill.style.width=n+'%';
    pct.textContent=n+'%';

    if(n>=100){
      clearInterval(timer);

      setTimeout(()=>{
        loginScreen.style.display='none';
        matrix.style.display='block';
        startMatrix();
      },1000);
    }
  },35);
});

help.addEventListener('click',()=>{
  modal.style.display='flex';
});

closeModal.addEventListener('click',()=>{
  modal.style.display='none';
});

modal.addEventListener('click',e=>{
  if(e.target===modal)modal.style.display='none';
});

function startMatrix(){
 const canvas=document.getElementById('canvas');
 const ctx=canvas.getContext('2d');

 canvas.width=innerWidth;
 canvas.height=innerHeight;

 const size=16;
 const columns=Math.ceil(canvas.width/size);
 const drops=Array(columns).fill(1);

 const chars='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

 function frame(){
   ctx.fillStyle='rgba(0,0,0,.09)';
   ctx.fillRect(0,0,canvas.width,canvas.height);

   ctx.fillStyle='#00ff66';
   ctx.font=size+'px monospace';

   for(let i=0;i<drops.length;i++){
     const ch=chars[Math.floor(Math.random()*chars.length)];
     ctx.fillText(ch,i*size,drops[i]*size);

     if(
       drops[i]*size>canvas.height &&
       Math.random()>.975
     ){
       drops[i]=0;
     }

     drops[i]++;
   }
 }

 const timer=setInterval(frame,45);

 setTimeout(()=>{
   const final=document.getElementById('final');
   final.classList.remove('hidden');

   requestAnimationFrame(()=>{
     final.classList.add('fadeIn');
   });
 },4500);
}

window.addEventListener('resize',()=>{});
});
</script>

</body>
</html>
